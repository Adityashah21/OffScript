{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://offscript-admin.vercel.app",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://offscript-admin.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/collections",
      "destination": "/collections/discover",
      "permanent": false
    },
    {
      "source": "/product",
      "destination": "/collections/discover",
      "permanent": false
    },
    {
      "source": "/order",
      "destination": "/collections/discover",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "https://offscript-p9rk.onrender.com/static/:path*"
    }
  ]
}
